{
  "name": "merit-event-maker",
  "version": "0.0.0",
  "private": true,
  "description": "MERIT Entertainment — Event Maker. Browser-only event operations software. This manifest exists for the developer test/build tooling only; the app itself has no build step and loads no package in the browser. The one runtime dependency, @anthropic-ai/sdk, is used only by server/vlm-relay.mjs (npm run serve:vlm), the optional local relay that holds the vision-language API key in its own environment.",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:all": "node tests/run.mjs --all",
    "test:slow": "node tests/run.mjs --tag=slow",
    "test:list": "node tests/run.mjs --list",
    "serve": "node tests/serve.mjs",
    "serve:vlm": "node server/vlm-relay.mjs",
    "benchmark": "node benchmarks/run-benchmark.mjs",
    "benchmark:baseline": "node benchmarks/record-baseline.mjs",
    "benchmark:teaching": "node benchmarks/teach-ai/measure-teaching.mjs",
    "benchmark:retrieval": "node benchmarks/embedding/retrieval-benchmark.mjs",
    "benchmark:separation": "node benchmarks/embedding/measure-separation.mjs",
    "benchmark:zones": "node benchmarks/zones/measure-zones.mjs",
    "benchmark:facts": "node benchmarks/interpreter/measure-facts.mjs",
    "benchmark:contradictions": "node benchmarks/contradictions/measure-contradictions.mjs",
    "benchmark:review-order": "node benchmarks/review-order/measure-review-order.mjs",
    "benchmark:heldout": "node benchmarks/heldout/run-heldout.mjs",
    "benchmark:false-positives": "node benchmarks/false-positives/measure-false-positives.mjs",
    "benchmark:adversarial": "node benchmarks/adversarial/run-adversarial.mjs",
    "benchmark:memory": "node benchmarks/memory/measure-memory.mjs",
    "perf": "node benchmarks/perf/run-perf.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "build:offline-full": "node scripts/build-offline-full.mjs",
    "verify:offline": "node benchmarks/offline/verify-offline-package.mjs",
    "vendor:test": "node scripts/fetch-test-vendor.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "acorn-walk": "8.3.4",
    "axe-core": "4.13.0",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0"
  }
}
